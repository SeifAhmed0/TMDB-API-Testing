    {
      "name": "GetPopularMovies",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "const results = body.results;\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Validate that Response contains results[] with 20 items per page\", function () {\r",
              "    pm.expect(results.length).to.equal(20);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Validate presence of: page, total_pages, total_results\", function () {\r",
              "    pm.expect(body).to.have.property('page');\r",
              "    pm.expect(body).to.have.property('total_pages');\r",
              "    pm.expect(body).to.have.property('total_results');\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Validate that Each movie includes: id, title, vote_average, popularity\", function () {\r",
              "    results.forEach((movie, index) => {\r",
              "        pm.expect(movie, `Movie ${index + 1} is missing 'id' property`).to.have.property('id');\r",
              "        pm.expect(movie, `Movie ${index + 1} is missing 'title' property`).to.have.property('title');\r",
              "        pm.expect(movie, `Movie ${index + 1} is missing 'vote_average' property`).to.have.property('vote_average');\r",
              "        pm.expect(movie, `Movie ${index + 1} is missing 'popularity' property`).to.have.property('popularity');\r",
              "    });\r",
              "});\r",
              "\r",
              "\r",
              "// pm.expect(20).to.be.above(10);       // >\r",
              "// pm.expect(20).to.be.at.least(20);    // >=\r",
              "// pm.expect(10).to.be.below(20);       // <\r",
              "// pm.expect(10).to.be.at.most(10);     // <=\r",
              "\r",
              "\r",
              "pm.test(\"Verify results are sorted by popularity (descending)\", function () {\r",
              "    for (let i = 0; i < results.length - 1; i++) {\r",
              "        pm.expect(results[i].popularity, `Movie #${i + 1} popularity should be >= Movie #${i + 2} popularity`).to.be.at.least(results[i + 1].popularity);\r",
              "    }\r",
              "});\r",
              ""
