      "name": "SearchMoviesbyKeyword",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "const results = pm.response.json().results;\r",
              "//console.log(body);\r",
              "\r",
              "pm.test(\"Validate that Status code is 200\", function () {\r",
              "    pm.expect(pm.response.code).to.eql(200);\r",
              "});\r",
              "\r",
              "// pm.test(\"Validate that Response contains results[] array\", function () {\r",
              "//     pm.response.to.have.jsonBody('results');\r",
              "// });\r",
              "\r",
              "pm.test(\"Validate that response contains results[] array\", function () {\r",
              "    pm.expect(body.results).to.be.exist;\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Validate that movie titles are relevant to the search keyword\", function () {\r",
              "    pm.expect(body.results[0].title).to.include(\"Inception\");\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Validate each result includes: id, title, release_date, overview\", function () {\r",
              "    results.forEach((movie, index) => {\r",
              "        pm.expect(movie, `Movie ${index + 1}`).to.have.property('id');\r",
              "        pm.expect(movie, `Movie ${index + 1}`).to.have.property('title');\r",
              "        pm.expect(movie, `Movie ${index + 1}`).to.have.property('release_date');\r",
              "        pm.expect(movie, `Movie ${index + 1}`).to.have.property('overview');\r",
              "    });\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Validate that total_results greater than Zero\", function () {\r",
              "    //pm.expect(results).to.not.be.empty;\r",
              "    //pm.expect(results.length).to.be.above(0);\r",
              "    pm.expect(results.length).to.be.greaterThan(0);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
